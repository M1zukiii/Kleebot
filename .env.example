DISCORD_TOKEN=put-your-token-here
COMMAND_PREFIX=!
# Optional: set this to your Discord server ID for instant slash-command sync.
# Without it, global slash commands may take a while to appear.
GUILD_ID=
YTDLP_COOKIES=/app/data/cookies.txt
YTDLP_DOWNLOAD_STREAMS=true
YTDLP_CACHE_DIR=/app/data/cache
PLAYLIST_LIMIT=50
SPOTIFY_USE_API=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_TIMEOUT=60
OPENAI_IMAGE_TIMEOUT=180
IMAGE_PROVIDER=openai
NOVELAI_TOKEN=
NOVELAI_MODEL=nai-diffusion-5-full
NOVELAI_WIDTH=1024
NOVELAI_HEIGHT=1024
NOVELAI_STEPS=28
NOVELAI_SCALE=6.0
NOVELAI_SAMPLER=k_euler_ancestral
NOVELAI_AVOID_ANLAS=true
NOVELAI_PLAIN_PROMPT=true
NOVELAI_NEGATIVE_PROMPT=lowres, artistic error, film grain, scan artifacts, worst quality, bad quality, jpeg artifacts, very displeasing, chromatic aberration, dithering, halftone, screentone, multiple views, logo, too many watermarks, negative space, blank page, @_@, mismatched pupils, glowing eyes, bad anatomy
KLEE_VISION_DAILY_LIMIT=3
KLEE_IMAGE_DAILY_LIMIT=0
# Optional: only set this for an OpenAI-compatible proxy.
OPENAI_BASE_URL=
# Optional: override Klee persona prompt path.
KLEE_PROMPT_FILE=/app/klee_prompt.txt
# Optional: keep mention replies cheaper by limiting recent @Klee context.
KLEE_CONTEXT_MESSAGES=6
KLEE_CONTEXT_CHARS=900
KLEE_VIDEO_METADATA_LIMIT=2


# Chat is independent of image generation. Existing OpenAI settings still work.
# To use DeepSeek: CHAT_PROVIDER=deepseek, DEEPSEEK_API_KEY=your-key.
CHAT_PROVIDER=openai
DEEPSEEK_API_KEY=
# Blank uses the selected provider's default model/key/base URL.
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_TIMEOUT=60
