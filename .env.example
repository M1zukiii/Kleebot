DISCORD_TOKEN=put-your-token-here
COMMAND_PREFIX=!
# Optional: set this to your Discord server ID for instant slash-command sync.
# Without it, global slash commands may take a while to appear.
GUILD_ID=
YTDLP_COOKIES=/app/data/cookies.txt
# Testing default: every fortune command redraws.
# Set true later if you want one deterministic fortune per user per day.
FORTUNE_DAILY_LOCK=false
